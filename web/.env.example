# Clerk publishable key (public — safe to expose in the built bundle).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Backend API base. Defaults to the deployed API Gateway if unset.
VITE_API_BASE=https://e6q9keyixh.execute-api.us-east-1.amazonaws.com/prod

# Local development without a Clerk instance (see dev-local.sh):
#   copy to .env.local and the Clerk key above becomes unnecessary
# VITE_AUTH_MODE=mock
# VITE_MOCK_USER_ID=user_local_dev
# VITE_API_BASE=http://localhost:8000
